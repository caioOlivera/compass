# Supabase: painel do projeto > Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://trwrzoejzdlcufmxmmsw.supabase.co
# "Publishable key" (sb_publishable_...). Pode ir para o navegador: a RLS protege os dados.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "Secret key" (sb_secret_...). Só no servidor, ignora a RLS. Nunca use com NEXT_PUBLIC_
# nem coloque no repositório.
SUPABASE_SERVICE_ROLE_KEY=

# Quem gera os roteiros: anthropic | openai-compatible | demo
#   demo              = sem IA, roteiro de exemplo fixo (grátis, para testar o fluxo)
#   openai-compatible = Ollama/LM Studio locais, Gemini, Groq, OpenRouter... (receitas no README)
#   anthropic         = Claude
AI_PROVIDER=demo

# --- AI_PROVIDER=openai-compatible ---
# Ex.: Ollama no seu computador
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen3:14b
# Opcional: modelos reserva, separados por vírgula, se o principal estiver sobrecarregado (503) ou no limite (429)
AI_FALLBACK_MODELS=
# Chave do provedor (vazio para Ollama/LM Studio)
AI_API_KEY=
# json_schema | json_object | nenhum. Troque para json_object se o provedor recusar json_schema.
AI_JSON_MODE=json_schema

# --- AI_PROVIDER=anthropic ---
# Crie em https://platform.claude.com > API keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Mais alto = roteiros mais cuidadosos, mais lentos e caros.
ANTHROPIC_EFFORT=medium

# Roteiros que cada usuário pode gerar a cada 24 h.
DAILY_GENERATION_LIMIT=5

# Mapa. Vazio = estilo gratuito do OpenFreeMap (sem token).
NEXT_PUBLIC_MAP_STYLE_URL=

# Fotos da landing, capas e paradas. Basta uma; vazio = cor + emoji.
# Unsplash: https://unsplash.com/developers (Access Key)
UNSPLASH_ACCESS_KEY=
# Pexels: https://www.pexels.com/api
PEXELS_API_KEY=

# Endereço público do site (links de volta do pagamento e do aviso do Mercado Pago).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pagamentos (Mercado Pago). Vazio = compra desligada; gerar segue grátis enquanto
# `cobranca_ativa` estiver false em /admin/config.
# Access Token de produção: https://www.mercadopago.com.br/developers/panel/app > Credenciais
MP_ACCESS_TOKEN=
# Chave secreta dos webhooks (Suas integrações > Webhooks). URL do aviso: <site>/api/webhooks/mercadopago
# Eventos: Pagamentos, Planos e assinaturas.
MP_WEBHOOK_SECRET=
# Testar antes de cobrar de verdade: MP_MODO=teste usa as credenciais de teste e o checkout sandbox.
# A chave secreta do webhook costuma ser a mesma da aplicação; sem MP_WEBHOOK_SECRET_TESTE, vale a de cima.
MP_MODO=producao
MP_ACCESS_TOKEN_TESTE=
MP_WEBHOOK_SECRET_TESTE=

# Passagens e hotéis (produto Completo e estudo em /admin/estudo). Vazio = só links de busca, sem preço.
# Travelpayouts: https://app.travelpayouts.com > Perfil > API token; marker = seu ID de parceiro; trs = ID do projeto.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_TRS=
# Opcional: script "Drive" da Travelpayouts, só nas páginas públicas (o src do código que o painel mostra)
TRAVELPAYOUTS_DRIVE_URL=
# SerpApi (diárias de hotel pelo Google Hotels): https://serpapi.com/manage-api-key
SERPAPI_KEY=
# Senha do agendamento diário que atualiza passagens e hotéis dos roteiros completos (vercel.json)
CRON_SECRET=

# Suporte. WhatsApp do consultor (só dígitos, com DDI e DDD), aparece para quem comprou a consultoria.
NEXT_PUBLIC_WHATSAPP=
# Avisos de chamado por e-mail pelo Resend (https://resend.com, plano grátis de 3 mil e-mails/mês). Opcional.
RESEND_API_KEY=
# Remetente com domínio verificado no Resend, ex.: "Compass <suporte@seudominio.com.br>"
EMAIL_REMETENTE=
# Quem recebe os chamados novos
SUPORTE_EMAIL=

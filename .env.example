# Supabase (Auth + Postgres). Painel do projeto > Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca exponha com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Motor de roteiros (Claude). https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Mapa. Vazio = estilo gratuito do OpenFreeMap (sem token).
NEXT_PUBLIC_MAP_STYLE_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

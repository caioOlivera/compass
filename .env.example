# Supabase: painel do projeto > Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://trwrzoejzdlcufmxmmsw.supabase.co
# "Publishable key" (sb_publishable_...). Pode ir para o navegador: a RLS protege os dados.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "Secret key" (sb_secret_...). Só no servidor, ignora a RLS. Nunca use com NEXT_PUBLIC_
# nem coloque no repositório.
SUPABASE_SERVICE_ROLE_KEY=

# Quem gera os roteiros: anthropic | openai-compatible | demo
#   demo              = sem IA, roteiro de exemplo fixo (grátis, para testar o fluxo)
#   openai-compatible = Ollama/LM Studio locais, Gemini, Groq, OpenRouter... (receitas no README)
#   anthropic         = Claude
AI_PROVIDER=demo

# --- AI_PROVIDER=openai-compatible ---
# Ex.: Ollama no seu computador
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen3:14b
# Chave do provedor (vazio para Ollama/LM Studio)
AI_API_KEY=
# json_schema | json_object | nenhum. Troque para json_object se o provedor recusar json_schema.
AI_JSON_MODE=json_schema

# --- AI_PROVIDER=anthropic ---
# Crie em https://platform.claude.com > API keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Mais alto = roteiros mais cuidadosos, mais lentos e caros.
ANTHROPIC_EFFORT=medium

# Roteiros que cada usuário pode gerar a cada 24 h.
DAILY_GENERATION_LIMIT=5

# Mapa. Vazio = estilo gratuito do OpenFreeMap (sem token).
NEXT_PUBLIC_MAP_STYLE_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
